  <property name="styleSheet">
   <string notr="true">/* Nền của toàn bộ ứng dụng */
QWidget {
    background-color: #f0f2f5;
    font-family: &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;
}

/* Tiêu đề (Đặt objectName cho các Label tiêu đề là lbl_title) */
QLabel#lbl_title {
    color: #1a1a1a;
    font-size: 24px;
    font-weight: bold;
}
QLabel#lbl_title_2 {
    color: #1a1a1a;
    font-size: 24px;
    font-weight: bold;
}

/* Các ô nhập liệu (Textboxes) */
QLineEdit {
    background-color: #ffffff;
    border: 2px solid #dcdfe6;
    border-radius: 8px;
    padding: 10px 15px;
    font-size: 14px;
    color: #333333;
}

QLineEdit:focus {
    border: 2px solid #409eff;
    background-color: #f2f8fe;
}

/* Nút bấm chính (Đăng nhập / Đăng ký) */
QPushButton#btn_login, QPushButton#btn_register {
    background-color: #409eff;
    color: white;
    border-radius: 8px;
    padding: 12px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#btn_login:hover, QPushButton#btn_register:hover {
    background-color: #66b1ff;
}

QPushButton#btn_login:pressed, QPushButton#btn_register:pressed {
    background-color: #3a8ee6;
}

/* Nút chuyển trang dạng text link */
QPushButton#btn_switch_register, QPushButton#btn_switch_login {
    background-color: transparent;
    color: #409eff;
    border: none;
    font-size: 13px;
    text-decoration: underline;
}

QPushButton#btn_switch_register:hover, QPushButton#btn_switch_login:hover {
    color: #66b1ff;
}</string>
